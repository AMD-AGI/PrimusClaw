{
  "extends": "../claw/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@primusclaw/personal-agent": ["./packages/core/src/index.ts"],
      "@primusclaw/personal-agent-runtime": ["./packages/runtime/src/index.ts"],
      "@primusclaw/personal-agent-teams": ["./packages/teams/src/index.ts"],
      "@primusclaw/personal-agent-teams/connector-hosts": ["./packages/teams/src/connector-hosts.ts"],
      "@primusclaw/personal-agent-teams-ingress": ["./packages/teams-ingress/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "test-support", "test", "scripts/*.ts"]
}
