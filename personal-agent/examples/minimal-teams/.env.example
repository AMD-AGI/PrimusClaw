#
# The smallest configuration of the Teams worker that answers real people (see ../../docs/quickstart.md). Every value
# is a placeholder. Copy it to .env next to docker-compose.yml (or anywhere outside a repository), fill it in, and keep
# the filled-in file out of version control: it holds the encryption key, the bot's client secret and the queue
# connection strings.
# Every other setting has a default; ../../docs/configuration.md describes them all.

# Claw, and the platform it authenticates people with (the worker asks its /users/self whose a linked key is).
CLAW_API_URL=https://claw.example.com/claw-api
SAFE_API_URL=https://safe.example.com/api/v1
# This worker's public https origin: people's Claw API keys are linked at <origin>/primus-claw-agent/link.
PUBLIC_BASE_URL=https://agent.example.com

# One Fernet key: openssl rand -base64 32 | tr '+/' '-_'
TEAMS_ENCRYPTION_KEYS=<fernet-key>

# The two queues: the inbound one with sessions enabled, both under these names unless you set INBOUND_QUEUE and
# OUTBOUND_QUEUE.
SERVICEBUS_LISTEN_CONNECTION_STRING=<listen-connection-string>
SERVICEBUS_SEND_CONNECTION_STRING=<send-connection-string>
# INBOUND_QUEUE=primusclaw-inbound
# OUTBOUND_QUEUE=primusclaw-outbound

# The worker posts replies to the Bot Connector itself, as the bot (quickstart step 2).
OUTBOUND_MODE=direct

# The bot as an app registration with a client secret (step 2a; needs a worker newer than 0.2.0). BOT_CLIENT_ID is the
# application's client id, the same id the Teams app manifest names as botId. No API permission is needed.
BOT_TOKEN_SOURCE=secret
BOT_CLIENT_ID=<app-registration-client-id>
BOT_TENANT_ID=<your-tenant-id>
BOT_CLIENT_SECRET=<client-secret-value>

# Or the bot as a user-assigned managed identity (step 2b): delete the four lines above and uncomment these. Outside
# Azure its token comes by workload identity federation, signed with your own key; on an Azure VM or AKS node that has
# the identity assigned, keep only BOT_MSI_CLIENT_ID: the default source, imds, asks the node.
# BOT_MSI_CLIENT_ID=<bot-identity-client-id>
# BOT_TOKEN_SOURCE=federated
# BOT_TENANT_ID=<your-tenant-id>
# BOT_ASSERTION_KEY_FILE=/run/secrets/assertion-key.pem
# BOT_ASSERTION_ISSUER=https://issuer.example.com
# BOT_ASSERTION_SUBJECT=personal-agent
