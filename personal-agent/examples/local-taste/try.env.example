#
# The worker on your own machine, without Teams (see ../../docs/quickstart.md, "Try it locally"). It runs the release
# gate's test entry: no Service Bus, the HTTP server on 127.0.0.1 only, and every reply posted to the stand-in Bot
# Connector at TEAMS_GATE_CONNECTOR_URL. Never use these settings for a deployment that real people reach.

# Your Claw API and the platform (SaFE) it authenticates with. Without a Claw, leave the placeholders: the worker still
# starts and answers a person who has not linked an account.
CLAW_API_URL=https://claw.example.com/claw-api
SAFE_API_URL=https://safe.example.com/api/v1
PUBLIC_BASE_URL=http://127.0.0.1:8080

# One Fernet key. Generate it with: openssl rand -base64 32 | tr '+/' '-_'
TEAMS_ENCRYPTION_KEYS=<fernet-key>

# The test entry: all three, exactly so.
TEAMS_GATE_ENTRY=1
GATE_RUN_ID=local-taste
TEAMS_GATE_CONNECTOR_URL=http://127.0.0.1:3978
