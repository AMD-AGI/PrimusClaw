# Copyright Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT
#
# Example environment for the personal agent's Teams worker. Every name below is one the worker reads; every value is
# a placeholder. Copy it outside the repository, fill it in, and keep secrets in a secret store (see "Secrets" below).
#
# The worker checks its settings at start: a missing required setting, a malformed number or an unknown word in a
# strict switch stops it before it takes a message. Some feature switches are lenient: ones read as "exactly 1" or
# "1/true/yes/on" treat a typo as off, and REMOTE_PUSH_ENABLED treats a typo as on (see ../docs/configuration.md,
# "How switches read"). Lines that are commented out show the default, or an optional setting that is off by default.
# Not listed: the release gate's test entry (TEAMS_GATE_*), which production never sets, and the FEEDBACK_* settings,
# which only a deployment's own feedback plugin reads.

# ---------------------------------------------------------------------------------------------------------------------
# Claw and the platform (required)
# ---------------------------------------------------------------------------------------------------------------------
CLAW_API_URL=https://claw.example.com/claw-api
SAFE_API_URL=https://platform.example.com
# The worker's own public origin: the account-link endpoint lives under it, and the exchange URLs default to it.
PUBLIC_BASE_URL=https://agent.example.com

# Optional Claw settings.
# CLAW_PLUGIN_ID=
# CLAW_RULE_TOOL_ID=
# CLAW_CLIENT_LABEL=clawy
# CLAWY_MODEL=
# CLAWY_FALLBACK_MODEL=
# CLAWY_REVIEW_MODEL=

# ---------------------------------------------------------------------------------------------------------------------
# Process and state
# ---------------------------------------------------------------------------------------------------------------------
# PORT=8080
# METRICS_PORT=9090
# PA_DB_PATH=/data/state.db

# ---------------------------------------------------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------------------------------------------------
# env (default): secrets come from the environment. keyvault: from Azure Key Vault, read as the worker identity below;
# the environment values of the secrets are then ignored.
# SECRETS_SOURCE=env
# KEYVAULT_URL=https://<your-vault-name>.vault.azure.net

# Comma separated Fernet keys; the first encrypts, all decrypt (rotate by putting the new key first).
# Generate one with: openssl rand -base64 32 | tr '+/' '-_'
PA_ENCRYPTION_KEYS=<fernet-key>

# ---------------------------------------------------------------------------------------------------------------------
# How the worker reaches Teams
# ---------------------------------------------------------------------------------------------------------------------
# servicebus (default): replies go to the outbound queue for a relay to post. direct: the worker posts to the Bot
# Connector itself (needed for streaming and deletes), with the queue as the fallback.
# OUTBOUND_MODE=servicebus

# The bot's token in direct mode: imds (a managed identity), federated (workload identity federation) or secret (an app
# registration's client secret). When BOT_TOKEN_SOURCE is unset: secret if BOT_CLIENT_SECRET is set, else imds; when it
# is set it always wins, and a BOT_CLIENT_SECRET beside another source is ignored with a warning.
# BOT_TOKEN_SOURCE=imds
# BOT_MSI_CLIENT_ID=<bot-identity-client-id>
# BOT_CLIENT_ID=<app-registration-client-id>
# BOT_CLIENT_SECRET=<client-secret-value>
# BOT_TENANT_ID=<your-tenant-id>
# BOT_ASSERTION_KEY_FILE=/var/run/secrets/agent/assertion-key.pem
# BOT_ASSERTION_ISSUER=https://issuer.example.com
# BOT_ASSERTION_SUBJECT=<federated-credential-subject>

# ---------------------------------------------------------------------------------------------------------------------
# Service Bus queues
# ---------------------------------------------------------------------------------------------------------------------
# Either the namespace's host name (reached as the worker identity) or the two connection strings.
# SERVICEBUS_NAMESPACE=<your-namespace>.servicebus.windows.net
SERVICEBUS_LISTEN_CONNECTION_STRING=<listen-connection-string>
SERVICEBUS_SEND_CONNECTION_STRING=<send-connection-string>
# INBOUND_QUEUE=primusclaw-inbound
# OUTBOUND_QUEUE=primusclaw-outbound
# RECEIVER_COUNT=8

# The worker's own Azure identity, needed with SERVICEBUS_NAMESPACE or SECRETS_SOURCE=keyvault. It signs with the
# BOT_ASSERTION_* key above.
# WORKER_IDENTITY_CLIENT_ID=<worker-identity-client-id>
# WORKER_IDENTITY_SUBJECT=<federated-credential-subject>

# ---------------------------------------------------------------------------------------------------------------------
# Features (all off by default)
# ---------------------------------------------------------------------------------------------------------------------
# Claw's notifications: exactly 1 turns them on, and Claw then posts each person's events to
# NOTIFY_WEBHOOK_URL/<route> (this worker's /claw-events). REMOTE_PUSH_ENABLED (default on) needs them.
# PROACTIVE_ENABLED=1
# NOTIFY_WEBHOOK_URL=https://agent.example.com/claw-events
# REMOTE_PUSH_ENABLED=on
# On: an event for a person with no chat is answered 410 Gone instead of 200.
# PA_CLAW_EVENTS_GONE=off

# The assistant (a person's standing agent in Claw).
# People are named by their Microsoft Entra object id (case does not matter); an empty list means everybody.
# ASSISTANT_ENABLED=1
# ASSISTANT_USERS=<entra-object-id>,<entra-object-id>
# ASSISTANT_REPLY_WINDOW_SECONDS=1800
# PA_ASSISTANT_UNDERSTANDING=off
# PA_ASSISTANT_UNDERSTANDING_USERS=<entra-object-id>
# Scheduled assistant work, job watching and /brief: exactly 1 turns each on.
# ASSISTANT_SCHEDULES_ENABLED=1
# ASSISTANT_JOB_WATCH_ENABLED=1
# BRIEF_ENABLED=1

# Remote agents (coding agents on a person's own machine, reached through claw-connector): exactly 1 turns
# them on. REMOTE_WINDOW_DEFAULT is card or chat.
# REMOTE_AGENTS_ENABLED=1
# REMOTE_WINDOW_DEFAULT=card

# A chat attached to a remote agent session becomes that agent's own window (empty list with on: everybody).
# PA_DIRECT_CHAT=off
# PA_DIRECT_CHAT_USERS=<entra-object-id>

# Who may say /observe on in a group chat, making their assistant the group's observer (empty: nobody).
# PA_OBSERVE_USERS=<entra-object-id>

# Token exchange with the identity service (RFC 8693), instead of linked API keys.
# PA_EXCHANGE_ENABLED=1
# PA_EXCHANGE_CLIENT_ID=<exchange-client-id>
# PA_EXCHANGE_CLIENT_SECRET=<exchange-client-secret>
# PA_EXCHANGE_TOKEN_URL=https://agent.example.com/oauth/token
# PA_EXCHANGE_BINDING_REQUEST_URL=https://agent.example.com/oauth/binding-requests
# PA_EXCHANGE_ISSUER=teams.microsoft.com
# PA_EXCHANGE_AUDIENCE=claw-api
# PA_EXCHANGE_SCOPE=claw.api
# PA_EXCHANGE_FOR_CHAT=0

# Pull request review for a colleague (needs the exchange).
# PA_GITHUB_REVIEW_ENABLED=1
# PA_GITHUB_REVIEW_OWNERS=example-org
# PA_REVIEW_INTENT_MODEL=
# PA_GITHUB_CREDENTIAL_URL=https://agent.example.com/oauth/external-credentials
# PA_GITHUB_CLIENT_ID=

# Claw user ids whose own key may post into their own chat; read for a deployment's own plugins.
# PA_ON_BEHALF_USERS=<claw-user-id>

# ---------------------------------------------------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------------------------------------------------
# PA_USER_MESSAGE_LIMIT=20
# PA_USER_MESSAGE_WINDOW_SECONDS=60
# PA_USER_MAX_CONCURRENT_TASKS=12
# PA_LINK_MAX_FAILURES_PER_USER=5
# PA_LINK_MAX_FAILURES_GLOBAL=100
# PA_LINK_ATTEMPT_WINDOW_SECONDS=600
# Per-person limits of operations that act with someone's authority: COUNT/SECONDS, or 0 for no limit.
# PA_LIMIT_PR_REVIEW=30/3600
# PA_LIMIT_PR_MERGE=20/3600
# PA_LIMIT_APPROVAL=120/3600
# PA_LIMIT_REMOTE_AGENT=10/3600

# ---------------------------------------------------------------------------------------------------------------------
# Reply style in Teams (strict on/off switches; defaults shown)
# ---------------------------------------------------------------------------------------------------------------------
# TEAMS_INSTALL_HINT_URL=https://teams.example.com/l/app/<your-app-id>
# TEAMS_AI_LABEL=on
# TEAMS_STREAMING=personal,groupChat
# TEAMS_STREAM_TEXT=off
# TEAMS_ASSISTANT_RECEIPT=on
# TEAMS_ASSISTANT_PROGRESS=on
# TEAMS_ASSISTANT_STREAM_SAY=on
# TEAMS_OWN_THUMBS_MOBILE=on
# TEAMS_SUGGESTED_REPLIES=on
# TEAMS_CITATIONS=off

# ---------------------------------------------------------------------------------------------------------------------
# What a feedback report says about the deployment (image tags, shown in the report).
# ---------------------------------------------------------------------------------------------------------------------
# WORKER_IMAGE_TAG=
# CLAW_API_IMAGE_TAG=
# CLAW_BRAIN_IMAGE_TAG=
