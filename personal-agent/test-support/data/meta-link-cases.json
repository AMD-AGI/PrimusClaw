   "limit": 200,
   "expected": "Run the tests"
  },
  {
   "about": "credential",
   "input": "token sk-EXAMPLE-abcdef0123456789abcdef0123456789 at https://h.example",
   "limit": 200,
   "expected": "token (hidden) at https:​//h.example"
  },
  {
   "about": "bidi override inside the separator",
