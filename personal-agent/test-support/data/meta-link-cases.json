   "input": "Fetch https://evil.example/data.json",
   "limit": 200,
   "expected": "Fetch https:​//evil.example/data.json"
  },
  {
   "about": "after an underscore",
   "input": "_https://evil.example/x",
   "limit": 200,
   "expected": "_https:​//evil.example/x"
  },
  {
   "about": "after @ and /",
   "input": "a@https://evil.example x/https://b.example",
   "limit": 200,
   "expected": "a@https:​//evil.example x/https:​//b.example"
  },
  {
   "about": "markdown link",
   "input": "[docs](https://evil.example)",
   "limit": 200,
   "expected": "(docs)(https:​//evil.example)"
  },
  {
   "about": "no address",
