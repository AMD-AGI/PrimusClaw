{
  "about": "The Python worker's safe.whoami, safe.safe_user and safe.user_id_of on these /users/self answers (generated with httpx.MockTransport).",
  "cases": [
    {
      "label": "a full answer",
      "status": 200,
      "body": "{\"id\": \"u-1001\", \"name\": \"Ada Example\", \"email\": \"ada@example.com\", \"type\": \"SSO\"}",
      "whoami": ["Ada Example", "ada@example.com"],
      "safeUser": {
        "name": "Ada Example",
        "email": "ada@example.com",
        "type": "sso"
      },
      "userId": "u-1001"
    },
    {
      "label": "the user inside data",
      "status": 200,
      "body": "{\"data\": {\"id\": \"u-1002\", \"name\": \"Bo Example\", \"email\": \"bo@example.com\", \"type\": \"default\"}}",
      "whoami": ["Bo Example", "bo@example.com"],
      "safeUser": {
        "name": "Bo Example",
        "email": "bo@example.com",
        "type": "default"
      },
      "userId": "u-1002"
    },
    {
      "label": "data that is not an object is ignored",
      "status": 200,
      "body": "{\"data\": \"x\", \"id\": \"u-1003\", \"name\": \"Cy Example\"}",
      "whoami": ["Cy Example", ""],
      "safeUser": {
        "name": "Cy Example",
        "email": "",
        "type": ""
      },
      "userId": "u-1003"
    },
    {
      "label": "data that is a list is ignored",
