  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AMD-AGI/PrimusClaw.git",
    "directory": "personal-agent/packages/runtime"
  },
  "homepage": "https://github.com/AMD-AGI/PrimusClaw/tree/main/personal-agent#readme",
