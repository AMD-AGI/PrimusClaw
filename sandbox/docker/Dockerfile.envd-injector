# Dockerfile.envd-injector — minimal injector image
#
# Contains EnvD binary + statically compiled tmux + statically compiled iptables,
# used as initContainer to inject into any user image.
# When CodeInterpreter uses fromImage (arbitrary base image), this image copies EnvD, tmux,
# and iptables to a shared volume so users don't need to install dependencies in template steps.
#
# Usage (auto-generated by buildPodTemplate):
#   initContainers:
#   - name: envd-injector
#     image: primussafe/agent-sandbox-envd-injector:<tag>
#     command: ["sh", "-c", "cp /envd /shared/bin/envd && ... (see codeinterpreter_controller.go)"]
#     volumeMounts:
#     - name: envd-bin
#       mountPath: /shared/bin
#
# EnvD is compiled in the envd-builder stage below so the image can be built
# with Docker alone (no host-side Go toolchain required).
# tmux is statically compiled in the tmux-builder stage below (musl + libevent + ncurses)
# iptables is compiled in the iptables-builder stage below, patchelf modifies interpreter to point to
# /shared/bin/ld-musl-x86_64.so.1, bundled with musl libc to ensure it works in glibc containers

# ── Stage 0: Build EnvD ──────────────────────────────────────────────────────
FROM golang:1.27@sha256:4013ae0f9e7994f8535c58c811f8f863fbed38b72e0d51e6592156f758d66146 AS envd-builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -buildvcs=false -ldflags="-s -w" -o /envd ./cmd/envd/main.go

# ── Stage 1: Statically compile tmux ────────────────────────────────────────────────────
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS tmux-builder

RUN apk add --no-cache \
    build-base \
    libevent-dev \
    libevent-static \
    ncurses-dev \
    ncurses-static \
    bison \
    automake \
    autoconf \
    pkgconf \
    wget

# The tarball is verified before it is unpacked. Piping wget straight into tar
# builds whatever arrives, so a substituted archive would be compiled into the
# static binary that ends up in every sandbox.
ARG TMUX_VERSION=3.5a
ARG TMUX_SHA256=16216bd0877170dfcc64157085ba9013610b12b082548c7c9542cc0103198951
RUN wget -q -O /tmp/tmux.tar.gz \
        "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
    && echo "${TMUX_SHA256}  /tmp/tmux.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/tmux.tar.gz \
    && rm /tmp/tmux.tar.gz \
    && cd "tmux-${TMUX_VERSION}" \
    && ./configure LDFLAGS="-static" \
    && make -j"$(nproc)" \
    && strip tmux \
    && cp tmux /tmux

# ── Stage 2: Statically compile iptables-legacy ─────────────────────────────────────────
# xtables-legacy-multi is a multi-call binary (like busybox), distinguished by argv[0]
# for iptables / ip6tables. Static linking ensures it runs in any user base image.
# Kata guest kernel requires iptables-legacy; nftables backend is not compatible.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS iptables-builder

RUN apk add --no-cache \
    build-base \
    linux-headers \
    libmnl-dev \
    libmnl-static \
    wget \
    xz \
    patchelf

ARG IPTABLES_VERSION=1.8.10
ARG IPTABLES_SHA256=5cc255c189356e317d070755ce9371eb63a1b783c34498fb8c30264f3cc59c9c
RUN wget -q -O /tmp/iptables.tar.xz \
        "https://www.netfilter.org/projects/iptables/files/iptables-${IPTABLES_VERSION}.tar.xz" \
    && echo "${IPTABLES_SHA256}  /tmp/iptables.tar.xz" | sha256sum -c - \
    && tar xJf /tmp/iptables.tar.xz \
    && rm /tmp/iptables.tar.xz \
    && cd "iptables-${IPTABLES_VERSION}" \
    && ./configure \
        --disable-nftables \
        --enable-static \
        --disable-shared \
    && make -j"$(nproc)" \
    && strip iptables/xtables-legacy-multi \
    && cp iptables/xtables-legacy-multi /iptables \
    && patchelf --set-interpreter /shared/bin/ld-musl-x86_64.so.1 \
               --set-rpath /shared/bin /iptables \
    && cp /lib/ld-musl-x86_64.so.1 /musl-ld.so

# ── Stage 3: Fetch extra CA certificates (opt-in) ──────────────────────────────────────
# Produces a CA bundle the sandbox can be pointed at through NODE_EXTRA_CA_CERTS /
# REQUESTS_CA_BUNDLE, for environments whose egress sits behind a TLS-intercepting
# proxy. No runtime curl and no mutation of the user container's system trust store.
#
# EMPTY BY DEFAULT. An open-source image must not ship one organisation's trust
# root -- every anchor baked in here widens what the sandbox will accept for every
# user of the image. Opt in with a space-separated list of PEM URLs:
#
#   docker build --build-arg EXTRA_CA_CERT_URLS="https://host/root.crt https://host/issuing.crt" \
#     -f docker/Dockerfile.envd-injector .
#
# Use a content-addressed URL (a commit SHA, a digest). These become trust
# anchors, so whoever controls the ref controls what TLS the sandbox accepts.
#
# NOTE: nothing consumes this bundle today. The CodeInterpreter initContainer
# copies only envd, tmux, iptables and the musl loader into /shared/bin (see
# pkg/workloadmanager/codeinterpreter_controller.go), so /setup-amd-ca.sh is
# never invoked and would take its "bundle not found; skip" path if it were.
# Wiring it up means adding the copy there as well as building with URLs here.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS ca-fetcher

ARG EXTRA_CA_CERT_URLS=""

RUN apk add --no-cache ca-certificates wget

# The output files are always created, empty when no URLs were given, so the
# final stage's COPY instructions succeed either way. setup-amd-ca.sh already
# treats an empty bundle as "nothing to do".
RUN mkdir -p /extra-ca \
    && : > /extra-ca/ca-bundle.pem \
    && if [ -n "$EXTRA_CA_CERT_URLS" ]; then \
         i=0; \
         for url in $EXTRA_CA_CERT_URLS; do \
           i=$((i+1)); \
           wget -q -O "/extra-ca/ca-${i}.crt" "$url" \
             || { echo "error: could not fetch CA certificate: $url" >&2; exit 1; }; \
           grep -q 'BEGIN CERTIFICATE' "/extra-ca/ca-${i}.crt" \
             || { echo "error: not a PEM certificate: $url" >&2; exit 1; }; \
           cat "/extra-ca/ca-${i}.crt" >> /extra-ca/ca-bundle.pem; \
         done; \
         echo "bundled $i extra CA anchor(s)."; \
       else \
         echo "no extra CA anchors requested (EXTRA_CA_CERT_URLS empty)."; \
       fi

# ── Stage 4: Final injector image ─────────────────────────────────────────────────────
FROM busybox:1.38.0-musl@sha256:32b5cdad7cce41dfd53d0ae06baebcf8357a147ee7694dc706911c373bc30c37

COPY --from=envd-builder /envd /envd
COPY --from=tmux-builder /tmux /tmux
COPY --from=iptables-builder /iptables /iptables
COPY --from=iptables-builder /musl-ld.so /musl-ld.so
# Empty unless the build opted in via EXTRA_CA_CERT_URLS.
COPY --from=ca-fetcher /extra-ca/ca-bundle.pem /amd-bundle.pem
COPY docker/scripts/setup-amd-ca.sh            /setup-amd-ca.sh
RUN chmod +x /setup-amd-ca.sh