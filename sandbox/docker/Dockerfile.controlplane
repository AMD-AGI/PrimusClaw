# Dockerfile for the unified controlplane component.

FROM golang:1.27@sha256:2920bb124f1a2e12a1d39f0cab756ae0068441ee1da7655dec7f5e374944095b AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o controlplane ./cmd/controlplane

# The SaFE API certificate is issued by the AMD issuing CA. Append both AMD
# CAs to the system bundle Go uses for TLS verification.
COPY docker/certs/amd-root-ca.crt docker/certs/amd-issuing-ca.crt /usr/local/share/ca-certificates/
RUN update-ca-certificates

FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
COPY --from=builder /workspace/controlplane /controlplane
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
EXPOSE 8080 8081 8082 8083
ENTRYPOINT ["/controlplane"]
