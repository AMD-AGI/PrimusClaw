# Test artifacts (allow .test.ts sources; ignore generated snapshots + coverage)
packages/*/test/__snapshots__/
packages/*/test/coverage/
packages/*/test/.tmp/

# Local soak/loop scratch (per-round logs + runner, not for VCS)
.rich-test-loop*

# OS
.DS_Store
Thumbs.db
