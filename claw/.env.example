# Claw-harness V2 Environment Variables

# Runtime mode. Affects logging/startup validation only — it does NOT disable
# authentication. Use `production` unless you are running locally.
APP_ENV=production

# Local-development auth bypass. When set to 1 (and APP_ENV is dev/development/
# local) every request skips SaFE verification and is treated as a system-admin.
# Leave empty. Never set this in a shared or internet-reachable deployment.
CLAW_INSECURE_DEV_AUTH=

# NATS — multi-tenant isolation via per-account credentials. Leave
# NATS_USER empty for anonymous/default account (local dev). In shared
# clusters, each dev runs `deploy/make-dev-account.sh` to
# provision a DEV_<whoami> account and populate these values.
NATS_URL=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=

# Replica count for the streams and KV buckets the API and Brain create. The
# default of 3 matches the clustered NATS the Helm chart installs. A single
# `nats-server -js` -- which is what the local quick start above implies --
# cannot serve it: JetStream refuses replicas>1 in non-clustered mode and the
# process exits while provisioning. NATS_REPLICAS=1 is the whole local fix; the
# per-object variables below only exist to override it one object at a time.
#
# Do not leave the two stream settings at 1 on a cluster. A single-replica
# stream lives on exactly one server, and when that server's pod goes away
# nothing is hosting `tasks.>`: every publish returns NO_RESPONDERS, which the
# client reports as the bare code "503", and POST /sessions fails for as long
# as the pod is gone. That is the 2026-09-01 outage.
NATS_REPLICAS=
TASK_STREAM_REPLICAS=
EVENT_STREAM_REPLICAS=
BRAIN_REGISTRY_REPLICAS=
BRAIN_CHECKPOINTS_REPLICAS=
SYSTEM_ENV_REPLICAS=
DAG_HANDLES_REPLICAS=

# PostgreSQL. Optional DB_SCHEMA sets `search_path` per connection for
# logical multi-tenancy (e.g. DB_SCHEMA=alice). Identifier validated
# against /^[A-Za-z_][A-Za-z0-9_]{0,62}$/.
DATABASE_URL=
DB_SCHEMA=

# Shared secret for Brain<->Hands / Brain<->API auth, also presented to
# SaFE as the X-Internal-Token header (formerly split as SAFE_AUTH_TOKEN
# + INTERNAL_TOKEN, now unified).
AUTH_INTERNAL_TOKEN=

# Shared identity client (OIDC discovery + JWKS, RFC 7662 introspection, RFC 8693
# token exchange). Off unless IDENTITY_CLIENT_ENABLED is true, and it authenticates
# a request only through an access token: a connector's (with remote agents on) or
# the token credential below; see claw/docs/identity-client.md. Left commented
# out so `source .env` does not export blanks. The three requireds apply only
# when it is enabled; every other setting has a default.
# IDENTITY_CLIENT_ENABLED=true
# IDENTITY_ISSUER_URL=https://idp.example.com
# IDENTITY_CLIENT_ID=
# IDENTITY_CLIENT_SECRET=
# Accept an access token the identity provider issued (Authorization: Bearer <JWT>)
# as an API credential. Off unless true, and needs the identity client above.
# CLAW_IDENTITY_TOKEN_AUTH_ENABLED=true
# CLAW_IDENTITY_TOKEN_AUDIENCE=claw-api
# CLAW_IDENTITY_TOKEN_SCOPE=claw.api
# CLAW_IDENTITY_TOKEN_INTROSPECT=false
# Platform roles a token may confer: system-admin and/or system-admin-readonly,
# comma separated. Unset (the default): every token's caller is a plain user. A
# named role is adopted only for a token that claims it and whose provider answer
# (RFC 7662) is active, names the same subject and lists it.
# CLAW_IDENTITY_TOKEN_TRUSTED_ROLES=system-admin

# Platform roles (SaFE's names), comma separated, of which a caller must hold at
# least one to use Claw at all; anyone else gets a 403 platform_access_required
# ("no access yet - ask an administrator") on every authenticated route. Unset (the
# default): nothing is checked. Only a credential SaFE verifies brings roles (the
# session cookie, an `ak-` key), so with this set an identity token, a connector token
# and a BYOK key are refused too. SaFE's answer is cached for five minutes, so a role
# granted or withdrawn takes that long to apply.
# CLAW_REQUIRED_PLATFORM_ROLES=default

# Master key for the per-user env-var store (AES-256-GCM). REQUIRED: the API
# validates it in initUserEnvCrypto() before it opens the database or NATS, so
# a missing or malformed value is a startup crash, not a runtime surprise.
# Must be base64 of exactly 32 raw bytes -- generate one with
#   openssl rand -base64 32
# which is the same recipe deploy/common.sh uses when it bootstraps a values
# file. Treat it as a credential, and NEVER change it after the first run: a
# new key cannot decrypt env vars already stored under the old one.
USER_ENV_ENCRYPTION_KEY=

# Hands (local dev)
HANDS_MCP_URL=http://localhost:9100/mcp
WORKSPACE_PATH=/tmp/claw-workspace
MCP_PORT=9100

# Brain
EXECUTOR_HOST=0.0.0.0
EXECUTOR_PORT=8100
# BRAIN_ID defaults to brain-$(whoami) in start-all.sh when unset.
BRAIN_ID=
MAX_CONCURRENT=3
# Task redelivery budget. The brain's poison guard fires at TASK_MAX_DELIVER-1
# so an exhausted task is reported instead of being dropped by NATS unnoticed.
# Also how long a run may wait for its workspace gate: waiting spends one
# delivery per attempt, which at this value is ~60min at the jitter floor.
TASK_MAX_DELIVER=23
# Unacked ceiling for the shared brain-workers consumer, fleet-wide rather than
# per pod, and today the only bound on how many tasks execute at once. Keep it
# above replicas * MAX_CONCURRENT plus the tasks backing off on a lock, and
# raise it with TASK_MAX_DELIVER -- the waiting set is what fills it.
TASK_MAX_ACK_PENDING=256
ANTHROPIC_BASE_URL=https://cluster.example.com/llm-gateway
ANTHROPIC_AUTH_TOKEN=
DEFAULT_MODEL=claude-sonnet-4-20250514
# Brain wire protocol. Set this explicitly because both base URLs may point at
# the same gateway. Use "anthropic" for Messages API or "openai" for Chat
# Completions.
LLM_API_STYLE=anthropic
OPENAI_BASE_URL=
OPENAI_API_KEY=
# BYOK key verification auth style. Use "openai" for LiteLLM/OpenAI-compatible
# gateways, or "anthropic" only for the native Anthropic API.
BYOK_VERIFY_API_STYLE=openai

# API Server
API_PORT=8200
V1_BACKEND_URL=http://localhost:8000

# SaFE Platform
SAFE_API_URL=https://cluster.example.com
SANDBOX_NAMESPACE=default

# Default container images for the Hyperloom / GEAK prompt builders. Optional:
# when unset, callers of claw_build_hyperloom_prompt / claw_build_geak_prompt
# must pass `image` explicitly.
HYPERLOOM_DEFAULT_IMAGE=
GEAK_DEFAULT_IMAGE=
# OpenAI-compatible API base embedded in generated GEAK prompts. When unset,
# claw_build_geak_prompt callers must pass api_base explicitly.
LITELLM_API_BASE=
SAFE_DEFAULT_WORKSPACE=default

# SaFE workload integration.
SANDBOX_WORKLOAD_PRIORITY=0
SANDBOX_DEFAULT_TIMEOUT_SECONDS=86400
# Max time a sandbox may stay Pending/Creating before the message fails with
# reason sandbox_pending_timeout. 0 = wait forever. Default 3h.
SANDBOX_PENDING_TIMEOUT_SECONDS=10800
# Max time a dispatched sandbox may stay not-ready (image pull, container start)
# before the message fails with reason sandbox_start_timeout. 0 = wait forever. Default 15m.
SANDBOX_START_TIMEOUT_SECONDS=900
# Same ceiling for multi-node GPU clusters (giving up deletes the cluster), off by
# default because large images and Infera role pods routinely take longer. 0 = wait forever.
MULTI_NODE_START_TIMEOUT_SECONDS=0
# How long a Running sandbox stays after user jobs go idle. Default 15 minutes.
SANDBOX_IDLE_REUSE_SECONDS=900
# Consecutive sweeps that must agree a sandbox is empty (or its EnvD/Pod was
# replaced) before idle reclaim destroys it. Default 3; 1 = act on one probe.
SANDBOX_RECLAIM_CONFIRM_SWEEPS=
# Seconds after a failed jobs probe or a positive process count during which
# idle reclaim never destroys. Default 300; 0 disables.
SANDBOX_RECLAIM_QUIET_SECONDS=
# Total lifetime used when no request timeout is supplied.
MULTI_NODE_DEFAULT_TIMEOUT_SECONDS=86400

# Optional shared storage. Empty CLAW_DEPLOY_ROOT uses Brain HTTP for Hands;
# empty WORKSPACE_PERSIST_BASE disables filesystem sync and keeps S3 durability.
CLAW_DEPLOY_ROOT=
WORKSPACE_PERSIST_BASE=

# A workspace snapshot carries each repository's .git, so unpushed commits survive
# a rebuilt sandbox. A .git over either bound is left out whole and reported in a
# workspace_git_skipped event. Default 314572800 (300 MiB) and 2000; bytes = 0
# stops carrying .git at all. The same two bounds across all repositories together
# (largest dropped first): default 1073741824 (1 GiB) and 10000. The sandbox gets
# WORKSPACE_GIT_PROBE_TIMEOUT_SEC (default 60) to measure them; past that the rest
# of the workspace is still saved and each repository keeps its previously saved copy.
WORKSPACE_GIT_MAX_BYTES=
WORKSPACE_GIT_MAX_FILES=
WORKSPACE_GIT_TOTAL_MAX_BYTES=
WORKSPACE_GIT_TOTAL_MAX_FILES=
WORKSPACE_GIT_PROBE_TIMEOUT_SEC=

# S3
S3_ENDPOINT=http://cluster.example.com:32000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=claw
S3_REGION=us
# S3_API_ENDPOINT: optional override forcing S3 SDK traffic at a specific S3
# API endpoint. Falls back to S3_ENDPOINT when unset. Use this when
# S3_ENDPOINT was (mis)configured at a non-API URL such as the MinIO Console
# port (e.g. :32001) and specific callers (e.g. plugins) must go through the
# real S3 API port (e.g. :32000) instead.
S3_API_ENDPOINT=

# V1/V2 Cutover
V2_CUTOVER_TIME=
V2_FORCE_MODE=

# --- Local dev compatibility flags (optional; leave unset in production) ---
#
# PG_SSL_NO_VERIFY: connect to a cluster PostgreSQL through a port-forward
# where the server presents a self-signed cert; skips cert chain verification
# on the pg driver. Independent of the svc.cluster.local / ssl=true heuristics.
PG_SSL_NO_VERIFY=
#
# BRAIN_SESSION_ROOT: override the per-session workspace root used by the
# Brain engines. Defaults to /workspace (the SaFE sandbox mount). For local
# dev point at a writable path, e.g. /tmp/claw-workspace/brain.
BRAIN_SESSION_ROOT=
#
# ALLOW_CLUSTER_NATS: intended as a guard that makes start-all.sh refuse to
# start when NATS_URL resolves to a non-localhost host, so local session
# subjects (events.<sid>.*, tasks.<sid>.*) cannot leak into a shared cluster
# NATS stream.
#
# NOT IMPLEMENTED. No code reads this variable today, and setting it has no
# effect. Until the check exists, pointing a local stack at a cluster NATS
# will publish into it with no warning — check NATS_URL yourself.
ALLOW_CLUSTER_NATS=

# --- Phase-2 feature flags (default OFF; opt-in per deployment) ---
#
# WARNING — UPGRADE NOTE: Both flags default to false. Deployments that
# previously relied on long-term memory and/or skill self-evolution MUST
# set the corresponding flag to "true" during rollout, otherwise those
# features will silently stop working immediately after the upgrade.
# Existing DB rows (memories, skills, patterns) are preserved while OFF
# so flipping the flag back to "true" restores prior behavior.
#
# CLAW_MEMORY_ENABLED:
#   true  — user profile + long-term memory injected into system prompt;
#           save_memory tool persists; daily decay cron runs.
#   false — read/write/decay all short-circuit. Brain's save_memory tool
#           calls are silently discarded by the API (warn-logged as
#           "memory.write_skipped_flag_off") so the LLM may still attempt
#           to save; payloads are dropped server-side.
CLAW_MEMORY_ENABLED=false
#
# CLAW_SKILL_EVOLUTION_ENABLED:
#   true  — selectSkillsForTask injects skills; save_skill / *_skill_file
#           persist; pattern aggregation, feedback, probation graduation,
#           evolution worker, and daily cleanup all run.
#   false — all skill writes/reads short-circuit; evolve worker not started;
#           cleanup crons skipped. Brain's skill tools are silently
#           discarded by the API (warn-logged as "skill.write_skipped_flag_off").
CLAW_SKILL_EVOLUTION_ENABLED=false

# CLAW_TRIGGERS_ENABLED:
#   true  — /v1/triggers is served and a 30s loop starts runs on users' cron
#           schedules, each as the user who created the trigger (their key is
#           stored encrypted on the trigger). false — no table, route or loop.
#           Tunables: TRIGGER_MIN_INTERVAL_MINUTES (15), TRIGGER_MAX_PER_USER (20),
#           TRIGGER_DAILY_LIMIT_PER_USER (100), TRIGGER_RUN_TIME_LIMIT_SECONDS (1800).
CLAW_TRIGGERS_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════
# Optional settings
#
# Everything below has a working default in code. The values here are left
# EMPTY on purpose: this file is meant to be copied to .env verbatim, so a
# filled-in example would silently become a real setting -- and for the
# credential-shaped entries, a publicly known one.
# ═══════════════════════════════════════════════════════════════════════════

# --- Access control -------------------------------------------------------
#
# CORS_ORIGINS: comma-separated allowlist of browser origins. Empty means no
# cross-origin access: the API sends no Access-Control-Allow-Origin at all and
# a browser on another origin cannot read its responses. Same-origin callers
# are unaffected, which is every deployment the Helm chart produces -- the
# ingress serves the API and the frontend under one host. Set this only when a
# browser somewhere else genuinely needs in, and name those origins exactly;
# there is deliberately no wildcard, because the API also sets
# Access-Control-Allow-Credentials and the pair is what lets another site read
# an authenticated response with the visitor's session cookie.
CORS_ORIGINS=
#
# CLAW_ADMIN_TOKEN: bearer token for Brain's /admin routes. While empty the
# routes are disabled and answer 404 (not 401, so their existence is not
# advertised). Set it to enable them; treat it as a credential.
CLAW_ADMIN_TOKEN=
#
# HARNESS_USER_WHITELIST: comma-separated user IDs allowed to use the harness.
# Empty disables the whitelist and admits every authenticated user.
HARNESS_USER_WHITELIST=
#
# SAFE_PLATFORM_KEY: cluster-wide SaFE key used as a fallback when a task has
# no per-session platform key (DAG-driven dispatch). Prefer per-session keys;
# a cluster-wide key is shared blast radius.
SAFE_PLATFORM_KEY=
#
# AUTH_CLAW_TOKEN: legacy alias Hands checks before AUTH_INTERNAL_TOKEN. Leave
# empty and use AUTH_INTERNAL_TOKEN.
AUTH_CLAW_TOKEN=

# --- LLM -----------------------------------------------------------------
#
# ANTHROPIC_API_KEY: native Anthropic API key. Only for talking to the
# Anthropic API directly; through a gateway use ANTHROPIC_AUTH_TOKEN above.
ANTHROPIC_API_KEY=
# BYOK_VERIFY_MODELS_URL: override for the model-list endpoint used to verify
# a user-supplied key. Empty derives it from the configured base URL.
BYOK_VERIFY_MODELS_URL=
# ANTHROPIC_CLI_STREAM_CLOSE_ON_IDLE: close the CLI engine's stream when it
# goes idle instead of holding it open. Empty keeps the default behaviour.
ANTHROPIC_CLI_STREAM_CLOSE_ON_IDLE=

# --- Built-in web tools --------------------------------------------------
#
# Search-provider credentials for the built-in web_search tool. Set the one
# matching your provider; all empty disables provider-backed search.
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# --- Memory --------------------------------------------------------------
#
# MEMORY_BACKEND: "remote" routes memory through MEMORY_SERVICE_URL instead of
# the API's own store. Empty keeps the built-in backend. Requires
# CLAW_MEMORY_ENABLED=true to have any effect.
MEMORY_BACKEND=
MEMORY_SERVICE_URL=

# --- Sandbox defaults ----------------------------------------------------
#
# Applied when a session requests no explicit image or resources. Empty uses
# the values compiled into the sandbox provider.
DEFAULT_SANDBOX_IMAGE=
DEFAULT_SANDBOX_CPU=
DEFAULT_SANDBOX_MEMORY=
SANDBOX_CLUSTER_ID=
SANDBOX_POLL_TIMEOUT_MS=

# --- Shell tool limits (Hands) -------------------------------------------
#
# Timeouts in seconds, sizes in bytes. Empty uses the built-in defaults.
BASH_DEFAULT_TIMEOUT_SEC=
BASH_MAX_TIMEOUT_SEC=
BASH_OUTPUT_BYTES=
WAIT_DEFAULT_SEC=
WAIT_MAX_SEC=
# Background shells: BG_SHELL_ENABLED gates the feature entirely.
BG_SHELL_ENABLED=
BG_SHELL_MAX_CONCURRENT=
BG_SHELL_BUFFER_BYTES=
BG_SHELL_REAP_DELAY_MS=

# --- PostgreSQL pool and statement limits --------------------------------
PG_POOL_MAX=
PG_LOCK_POOL_MAX=
PG_POOL_CONNECT_TIMEOUT_MS=
PG_POOL_IDLE_TIMEOUT_MS=
PG_STATEMENT_TIMEOUT_MS=
PG_IDLE_TX_TIMEOUT_MS=
# POSTGRES_HOST / POSTGRES_PASSWORD: only for deployments that assemble the
# connection from parts instead of setting DATABASE_URL.
POSTGRES_HOST=
POSTGRES_PASSWORD=

# --- Task scheduling and dispatch ----------------------------------------
TASK_SCHEDULER_TICK_MS=
TASK_SCHEDULER_MAX_DISPATCH=
TASK_SCHEDULER_DISPATCH_TIMEOUT_MS=
TASK_DISPATCH_PUBLISH_TIMEOUT_MS=
TASK_DISPATCH_STAGE_TIMEOUT_MS=
TASK_DISPATCH_BIND_RETRY_SEC=
# Idempotency-key contention handling.
IDEM_LOCK_TIMEOUT_MS=
IDEM_BUSY_POLL_MS=
IDEM_BUSY_POLL_TRIES=

# --- Workspace reaper (CronJob) ------------------------------------------
#
# REAPER_DRY_RUN=1 reports what would be deleted without deleting it. Run the
# reaper this way first against any deployment with data you care about.
REAPER_DRY_RUN=
REAPER_MAX_DELETE_PER_RUN=
REAPER_TRASH_GRACE_HOURS=
REAPER_KV_GRACE_MIN=
WORKSPACE_GC_RETENTION_DAYS=
WORKSPACE_OWNER_API_URL=
# S3_WORKSPACE_TAGGING: apply object tags to uploaded workspace objects so a
# bucket lifecycle rule can expire them. Empty disables tagging.
S3_WORKSPACE_TAGGING=

# --- NATS KV buckets ------------------------------------------------------
#
# Not S3: these name the JetStream KV buckets the API creates and Brain
# attaches to (api/src/infra/nats.ts). Overridable only so parallel test
# environments can run side by side. Empty falls back to the names the API
# actually creates, BRAIN_CHECKPOINTS and BRAIN_REGISTRY -- point either at a
# bucket the API does not create and Brain fails to open it at startup.
BRAIN_CHECKPOINTS_BUCKET=
BRAIN_REGISTRY_BUCKET=

# --- Service wiring ------------------------------------------------------
#
# CLAW_PUBLIC_URL: externally reachable API base (scheme, host and any ingress
# path prefix, e.g. https://claw.example.com/claw-api), used when building URLs
# handed to sandboxes and callbacks and the interface URL of every A2A agent
# card. Empty derives from the request: the A2A cards use the proxy's
# X-Forwarded-Host/Proto/Prefix headers when present, else a relative URL.
CLAW_PUBLIC_URL=
# INTERNAL_BACKEND_URL: in-cluster API address Brain calls. Empty uses the
# service DNS name.
INTERNAL_BACKEND_URL=
# A2A_AGENTS: the peer agents the a2a_call tool may reach. Only a peer named here can be
# called: the model passes a name, never a URL, and a URL is refused. A peer is sent its own
# credential and nothing else; the user's LLM key and the platform key are never sent to one.
# Two forms:
#   name=url,name=url                                  no credential is sent
#   [{"name":"ci","url":"https://ci.example.com","auth_env":"A2A_PEER_TOKEN_CI"}]
# auth_env names an environment variable of this process that holds that peer's bearer token.
# The name must start with A2A_PEER_TOKEN_ (e.g. A2A_PEER_TOKEN_CI); an entry naming any other
# variable, such as ANTHROPIC_API_KEY, is refused at start-up with an error in the log and the
# peer is not registered, so a peer can never be sent a deployment-wide secret. Keep the token
# in a Secret; a named variable that is empty makes the peer uncallable, not unauthenticated.
# BREAKING: a2a_call used to accept any URL and send the user's key to it; it no longer does,
# so a peer reached that way must now be listed here, with its own token if it needs one
# (see CHANGELOG, Unreleased / Security). A peer on a loopback or link-local address (127.0.0.0/8, ::1, 169.254.0.0/16,
# fe80::/10, 0.0.0.0) is refused unless its entry sets "allow_local": true; private ranges are
# allowed, since an in-cluster peer lives there. Empty leaves a2a_call with no peers.
A2A_AGENTS=
# A2A server, context/task model. Off by default; with it off the server is the
# one it was. On: a contextId names a session owned by the authenticated caller
# and a taskId one run of it; a task needs the caller (a held tool call, or a
# question the agent asked) as INPUT_REQUIRED and is answered by a message with
# its taskId; CancelTask stops the run; a context runs one task at a time. The
# agent card says so. Left commented out so `source .env` does not export blanks.
# CLAW_A2A_CONTEXT_TASKS=true
# Client ids of the upstream services whose identity-provider access tokens may
# call A2A (comma separated). With the model on, an access token from any other
# client, or none, is refused: such a caller has no virtual key, so its runs are
# paid for by the deployment's shared LLM key. Other credentials are unaffected.
# CLAW_A2A_IDENTITY_CLIENT_IDS=dispatron
# A2A push notifications (needs the model above): a client registers a webhook
# for a task and is sent a StreamResponse on each change of state. Webhook URLs
# must be https and resolve to a public address; a host named in
# CLAW_A2A_PUSH_ALLOWED_HOSTS (comma separated) is the operator's exception, the
# only place plain http is accepted, for an in-cluster receiver.
# CLAW_A2A_PUSH_ENABLED=true
# CLAW_A2A_PUSH_ALLOWED_HOSTS=
EXTERNAL_RESOLVER_POLL_MS=

# --- Dispatch and fleet admission ----------------------------------------
#
# RUN_DOORBELL_DISPATCH: chat dispatch publishes a doorbell and injects
# credentials at claim time instead of putting the whole execute request on
# JetStream. Empty is true; the capability floor still has to open the runtime
# gate. Every ADMIT_* ceiling below requires this flag to remain true: with it
# false, chat bypasses admission and a ceiling meters only batch work, so the
# API refuses to boot on the combination.
RUN_DOORBELL_DISPATCH=
#
# RUN_FAT_PREPARING_RECONCILE: the API's assertion that every Brain able to
# receive `tasks.execute` takes a durable SQL holder before its execution gate.
# Empty is true. Blank is safe here -- unlike the ceilings below this one is
# read as a boolean, where an empty value is an absent setting and the default
# applies -- but it is declared rather than omitted because leaving it out is
# what makes an operator miss the rollout step.
#
# That step: a fleet rolling up from a release that predates the durable holder
# must set this to false BEFORE the first new API replica starts, and blank it
# again once every API and Brain replica is new. Asserted too early, a reaper
# closes a delivery that is about to execute. API-only; the Brain never reads
# it. `deploy/values.example.env` and `deploy/common.sh` carry the same switch
# for the chart path; this line is the local stack's copy of it.
RUN_FAT_PREPARING_RECONCILE=

# Cluster-wide admission ceilings. 0 means the dimension is not enforced, and
# these eight are the only keys in this section that carry a value rather than
# a blank, because a BLANK IS REFUSED here. Every value must be a whole
# non-negative number; anything else -- a blank line, a fractional value -- is
# reported as `startup.admission_settings_refused` and the API exits before
# Fastify listens. `start-all.sh` does `set -a; source .env`, which EXPORTS a
# key left empty as "" rather than leaving it absent, so eight blank lines here
# is `cp .env.example .env && scripts/start-all.sh` refusing to start at all.
#
# Softening the refusal to read blank as 0 is the wrong repair, which is why
# this file spells the default instead. 0 is the value that switches a
# dimension off, so a ceiling that failed to render -- a chart value that
# produced nothing, a substitution that came back empty -- would then be a
# silently unenforced ceiling the operator believes is set, and no `> 0` check
# anywhere can tell that apart from a deliberate 0. Writing 0 is not an
# override either: it is the same "not enforced" the code defaults to, said in
# the one spelling the guard can still distinguish from a value that got lost.
#
# A soft ceiling above its hard ceiling is refused too: the hard refusal runs
# first, so the soft one could never fire.
#
# Soft ceilings count what is executing now and their answer is "wait": the run
# sits at `queued` until a slot frees. Hard ceilings count everything the fleet
# has committed to, queued and parked runs included, and their answer is a
# refusal. Runs are counted by run-tree root, sandboxes and GPU nodes per row.
ADMIT_SOFT_RUNS=0
ADMIT_HARD_RUNS=0
ADMIT_SOFT_SANDBOXES=0
ADMIT_HARD_SANDBOXES=0
ADMIT_SOFT_GPU_NODES=0
ADMIT_HARD_GPU_NODES=0
# Bounds on one session tree -- sessions, not runs -- checked wherever a run
# enters the tree. 0 means unbounded.
ADMIT_TREE_MAX_NODES=0
ADMIT_TREE_MAX_DEPTH=0

# Hosted application runs: accept `mode: "app"` on
# POST /v1/sessions/:sessionId/tasks. Off by default; Brain does not run apps
# yet, so an admitted app run is refused there as not implemented.
APP_RUNS_ENABLED=false
# Whether the sandbox Router runs with --enable-auth (API and Brain, same value). It
# decides the `token` of a hosted application's session-level MCP: with auth on, the
# <SAFE_API_KEY> placeholder (Brain expands it to the session owner's platform key);
# with auth off, the run's MCP token. The application itself is always checked on the
# header its manifest declares.
SANDBOX_ROUTER_AUTH_ENABLED=false
# Platform caps on an app run's grant, one set of totals as JSON. Each item the
# submitter requests is clamped to its cap; unset = not capped. Example:
# APP_SANDBOX_CAPS={"max_sandboxes":8,"max_gpus":8,"gpu_hours":500,"max_runtime_sec":172800}
APP_SANDBOX_CAPS=
# The most one app container may ask for (gpus, cpu, memory_gi), as JSON. An item
# left out keeps its default (one node): 8 GPUs, 256 cpu, 4096 GiB. A request above
# it is a 400 naming the field. Example:
# APP_CONTAINER_CAPS={"gpus":8,"cpu":256,"memory_gi":4096}
APP_CONTAINER_CAPS=
# How long the grant service gets to answer issue/revoke before the attempt fails.
APP_GRANT_ISSUE_TIMEOUT_MS=10000
# After a failed or timed-out issue the revoke is tried again this long later, for a grant the
# service signed late (1000-300000 ms).
APP_GRANT_REVOKE_RETRY_MS=30000
