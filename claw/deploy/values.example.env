# ─────────────────────────────────────────────────────────────────
# Per-env values consumed by deploy/common.sh (fed into the Helm chart)
# at deploy time. Copy this file to values.<NAMESPACE>.env (e.g.
# values.primus-claw.env, values.primus-claw-dev.env), fill real
# values, and KEEP IT OUT OF GIT (.gitignore covers values.*.env
# except this template).
#
# Rule: if a key appears in secret.yaml as <KEY>, it MUST exist here
# (rendered output substitutes <KEY> -> value). Missing -> deploy.sh
# placeholder guard fails.
# ─────────────────────────────────────────────────────────────────

# AUTH internal token — internal HMAC secret (BYOK user-id derivation +
# Brain<->Hands/API auth).
#   * kubernetes mode (default): leave empty to auto-generate once + persist here.
#   * safe mode: REQUIRED — must match the SaFE apiserver token; set it here.
# NEVER change it after the first install — a new value re-keys every BYOK
# user id (users lose their existing sandboxes/data).
AUTH_INTERNAL_TOKEN=""

# Cluster ingress domain (REQUIRED). Used for:
#   * claw self-ingress host + Higress domain label (ingress.yaml)
#   * LLM gateway URLs ANTHROPIC_BASE_URL / OPENAI_BASE_URL /
#     BYOK_VERIFY_MODELS_URL = https://<DOMAIN>/llm-gateway (secret.yaml)
# Provide it here or via the DOMAIN=... env var; deploy fails fast if unset.
DOMAIN=""
# Browser origins allowed to call the API with credentials, comma-separated and
# including the scheme -- "https://claw-ui.example.com,https://admin.example.com".
#
# Empty is the current default and is NOT safe for a deployment a browser can
# reach: the API then reflects whatever Origin a request carries and still sends
# Access-Control-Allow-Credentials, so any site a logged-in user visits can call
# the API with their session cookie and read the replies. Set the origins your
# UI is actually served from.
#
# Leave empty if the UI is served from DOMAIN through this chart's own ingress:
# same-origin requests are not subject to CORS, so there is nothing to allow.
CORS_ORIGINS=""

# Per-user env vars AES-256-GCM master key.
# Generate once and store securely; never regenerate without running the
# rotation playbook (user-env-vars-design.md §8.3) — old encrypted rows
# become unreadable.
# Command: `openssl rand -base64 32` → 44-char base64 (decodes to 32 bytes).
USER_ENV_ENCRYPTION_KEY=""

# S3 / MinIO endpoint + keys.
# DEFAULT: auto-discovered at deploy time from the minio namespace
# (deploy/common.sh::resolve_minio_secrets_from_cluster):
#   S3_ENDPOINT     = http://minio.minio.svc.cluster.local:9000  (in-cluster svc DNS)
#   S3_API_ENDPOINT = S3_ENDPOINT
#   S3_ACCESS_KEY   = secret minio/minio data.rootUser     (base64-decoded)
#   S3_SECRET_KEY   = secret minio/minio data.rootPassword (base64-decoded)
# Discovery is WARN-only — minio missing/unreachable leaves the placeholder
# and the deploy.sh guard will flag the specific empty key.
#
# Override any of these for external S3 (e.g. NodePort host:port for an
# off-cluster MinIO, or a cloud S3 provider). Examples:
#   S3_ENDPOINT=http://cluster.example.com:32000
#   S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
S3_ENDPOINT=""
S3_API_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# minio discovery knobs — override only when the release name / namespace
# / svc port differs from the standard layout.
# MINIO_NAMESPACE=minio
# MINIO_SECRET_NAME=minio
# MINIO_SVC_NAME=minio
# MINIO_SVC_PORT=9000

# Brain shared-storage ROOT for hands-binary distribution.
# Brain auto-appends /<NAMESPACE>/hands-binary so dev/prod can share the same
# root mount (e.g. /shared/primus-claw -> /shared/primus-claw/<ns>/hands-binary).
# Empty -> sandbox downloads via Brain HTTP fallback (no shared mount needed).
# Non-empty -> sandbox execs binary directly from the per-namespace path;
# missing mount inside sandbox falls back to Brain HTTP automatically.
CLAW_DEPLOY_ROOT=""

# Optional shared workspace persistence. Empty disables filesystem checkpoint
# sync and leaves S3 as the durable fallback.
WORKSPACE_PERSIST_BASE=""

# OpenAI-compatible LiteLLM API used in generated GEAK task prompts.
LITELLM_API_BASE=""
SAFE_DEFAULT_WORKSPACE="default"

# SaFE scheduling and multi-node platform integration. Public defaults are
# neutral; environment-specific values belong in this ignored file.
SANDBOX_WORKLOAD_PRIORITY=0
SANDBOX_DEFAULT_TIMEOUT_SECONDS=86400
# Max time a sandbox may stay Pending/Creating before the message fails with
# reason sandbox_pending_timeout. 0 = wait forever. Default 3h.
SANDBOX_PENDING_TIMEOUT_SECONDS=10800

# How long a sandbox is allowed to live. Empty leaves whatever the sandbox
# platform's own template says, so a deployment that sets neither renders
# exactly what it rendered before.
#
# Both are Go durations ("90m", "2h30m", "48h"); a value that is not one is
# refused at startup with a message rather than silently dropped further down.
# Set them here and not by hand on the live Deployment: upgrade.sh re-renders
# it from the chart on every run.
#
# MAX_SESSION_DURATION is the absolute ceiling and nothing can push it back --
# on agent-sandbox it becomes ShutdownTime, on SaFE the Workload timeout (which
# is measured from the workload starting and excludes queue time, so it is a
# near-equivalent, not the identical guarantee).
#
# SESSION_TIMEOUT is the idle deadline, pushed back by activity. It exists only
# on agent-sandbox (CLAW_DEPLOY_MODE=kubernetes) -- SaFE has no idle concept to
# map it onto, and setting it in safe mode is reported at startup as a setting
# that does nothing.
AGENT_SANDBOX_SESSION_TIMEOUT=""
AGENT_SANDBOX_MAX_SESSION_DURATION=""
# Total lifetime when no request timeout is supplied; no extra shutdown buffer
# is added to this default.
MULTI_NODE_DEFAULT_TIMEOUT_SECONDS=86400

# Brain deployment sizing. Example: dev=3, prod=20.
BRAIN_REPLICAS=3

# --- Object storage bucket -------------------------------------------------
#
# Workspace snapshots and transcripts land here. Nothing in this repo creates
# the bucket -- MinIO is provisioned out-of-band (see deploy.sh's header) -- so
# it must already exist, or workspace sync has nowhere to write. Empty uses the
# chart default, "claw".
S3_BUCKET=""

# --- Ingress controller ----------------------------------------------------
#
# Empty uses the chart default, "higress". The chart emits its higress.io/*
# annotations -- the path rewrite and the 2g upload body size among them --
# only when this is "higress"; on another controller you get a plain Ingress
# and must supply that controller's equivalents through the chart value
# ingress.extraAnnotations.
INGRESS_CLASS=""

# --- Default sandbox ---------------------------------------------------------
#
# Seeds the resources table's type='default' row on the API's first migration,
# which is the bottom of the image/size resolution chain. The row is seeded
# either way so cpu/memory always resolve; setting an image here is what saves
# every caller from having to pass `sandbox_image` itself. Ignored once the row
# exists, so later edits to it are not reverted.
DEFAULT_SANDBOX_IMAGE=""
DEFAULT_SANDBOX_CPU=""
DEFAULT_SANDBOX_MEMORY=""

# --- Private CA (build-time) -------------------------------------------------
#
# Space-separated certificate URLs (PEM or DER) added to the image's trust
# store by deploy/build.sh,
# for an LLM gateway / SaFE / S3 endpoint signed by a CA the public trust store
# does not carry. This is the supported alternative to the chart's
# tls.insecureSkipVerify, which disables certificate verification for every
# outbound connection the image makes. Prefer a content-addressed URL (a commit
# SHA, a digest): whoever controls the ref controls what this image trusts.
EXTRA_CA_CERT_URLS=""
