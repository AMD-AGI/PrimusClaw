#
# Optional non-secret deployment profile for deploy/deploy.sh.
# Copy this file outside the repository (or into a locally ignored directory),
# fill environment-specific values, and load it with:
#   bash deploy/deploy.sh --config /path/to/deploy.env --dry-run
#
# Do not put credentials here. Use Kubernetes Secrets, Vault, CI secrets, or
# claw/deploy/values.<NAMESPACE>.env for AUTH/S3/encryption credentials.
# Command flags such as DRY_RUN and YES are not profile settings; pass
# --dry-run or --yes explicitly.

NAMESPACE="primus-claw"
CLAW_NAMESPACE="primus-claw"
LITELLM_NAMESPACE="primus-claw"
# Namespace the agent-sandbox control plane is installed into.
SANDBOX_NAMESPACE="agent-sandbox-system"
# Namespace sandbox workloads land in when a request carries no workspace_id.
# Empty keeps the chart default, which installs on a fresh cluster without
# pre-creating anything. Point it at a dedicated namespace -- not the control
# plane's -- to keep agent workloads isolated. The namespace must already exist.
SANDBOX_WORKLOAD_NAMESPACE=""
CLAW_DEPLOY_MODE="kubernetes"

DOMAIN="claw.example.com"
SAFE_API_URL="https://safe.example.com"

SANDBOX_IMAGE_REGISTRY="docker.io/primussafe/"
SANDBOX_IMAGE_TAG="latest"
CLAW_REGISTRY="docker.io/primussafe"
CLAW_TAG="latest"

# Optional scheduling and storage integration.
SANDBOX_NODE_SELECTOR=""
SANDBOX_CONTROLPLANE_NODE_SELECTOR=""
CLAW_DEPLOY_ROOT=""
WORKSPACE_PERSIST_BASE=""

# Optional runtime overrides.
LITELLM_API_BASE=""
SAFE_DEFAULT_WORKSPACE="default"
SANDBOX_WORKLOAD_PRIORITY="0"
SANDBOX_DEFAULT_TIMEOUT_SECONDS="86400"
# Max time a sandbox may stay Pending/Creating before the message fails with
# reason sandbox_pending_timeout. 0 = wait forever. Default 3h.
SANDBOX_PENDING_TIMEOUT_SECONDS="10800"
# Total lifetime used when the request has no timeout; no buffer is added.
MULTI_NODE_DEFAULT_TIMEOUT_SECONDS="86400"

# --- Sandbox recovery ---
# When Hands' MCP port stops answering, Brain asks the data plane whether the
# container is still there before doing anything destructive. One that is alive
# gets its Hands restarted in place, which preserves whatever the run left
# running in it -- background shells, Hyperloom jobs, GPU work. Only a container
# the data plane says is gone is replaced.
#
# The kill switch for that restart, and it only reaches as far as the start of
# a task. With it off, a task attaching to a session whose Hands has died
# replaces the sandbox instead, taking its background work with it, which is
# the behaviour from before this path existed. agent-sandbox falls back to the
# same replacement whenever AGENT_SANDBOX_WARM_POOL_SIZE is above zero, because
# a pooled pod's environment cannot be reproduced for the new Hands.
#
# Mid-run is deliberately not covered by either fallback: once a task is
# already using a container the data plane confirms is alive, nothing replaces
# it, because doing so destroys work that is still running to repair a tool
# server. Such a task reports that it cannot recover and ends after
# SANDBOX_RECOVERY_MAX_PER_TASK attempts.
#
# What the NEXT task gets depends on why the restart did not happen. Where it
# was refused outright -- this switch off, or a warm pool configured -- the
# next task replaces the sandbox when it attaches. Where the restart was
# attempted and failed, the next attach reports the same failure and leaves the
# sandbox intact, and every attach after it does the same, so clearing it takes
# a manual teardown (or the idle reaper, after SANDBOX_IDLE_REUSE_MS).
SANDBOX_HANDS_RESTART_ENABLED="true"
# How long to wait for a restarted Hands to answer /health: tries x interval.
SANDBOX_HANDS_RESTART_MAX_TRIES="10"
SANDBOX_HANDS_RESTART_INTERVAL_MS="2000"
# Wall clock for the kill + relaunch exec alone, health polling excluded. This
# sits on the tool-batch path, so the agent loop stops for it at worst.
SANDBOX_HANDS_RESTART_EXEC_DEADLINE_MS="45000"
# Per-task ceilings on the two repairs, counted separately: replacing the
# sandbox, and repairing it without destroying it. Either one reaching its
# limit stops that kind of repair for the rest of the task, and the model is
# told so it can stop retrying.
SANDBOX_REBUILD_MAX_PER_TASK="3"
SANDBOX_RECOVERY_MAX_PER_TASK="3"
