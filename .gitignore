# Process management
.harness-*.pid
**/__pycache__/

# Auto-generated evolution scripts (regenerated by LLM at runtime)
**/scripts/auto_*.py

# Ad-hoc scratch tests that depend on a local environment. The pattern is broad
# on purpose, so the canonical test directories are exempted below -- otherwise a
# contributor's new pytest file is silently never committed, and CI then fails on
# a fresh clone against a path that only ever existed in someone's worktree.
# (Tests committed before this rule are unaffected: ignores do not apply to files
# git already tracks, which is why it went unnoticed.)
test_*.py
!**/tests/test_*.py
!**/tests/**/test_*.py
!**/test/test_*.py
!**/test/**/test_*.py

# Environment files with secrets
.env
.env.*
**/.env
!**/.env.example

# Build artifacts
**/dist/
**/node_modules/
*.tsbuildinfo
*.log

# Coverage / pytest artifacts
.coverage
coverage.xml
.pytest_cache/

# Local Python dev environments and editable-install metadata
**/.venv/
**/*.egg-info/

# Editor and OS artifacts
.vscode/
.idea/
.cursor/
.claude/
*.swp
.DS_Store
