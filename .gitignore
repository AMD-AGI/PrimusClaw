# Process management
.harness-*.pid
**/__pycache__/

# Auto-generated evolution scripts (regenerated by LLM at runtime)
**/scripts/auto_*.py

# Ad-hoc scratch tests that depend on a local environment. The pattern is broad
# on purpose, so the canonical test directories are exempted below -- otherwise a
# contributor's new pytest file is silently never committed, and CI then fails on
# a fresh clone against a path that only ever existed in someone's worktree.
# (Tests committed before this rule are unaffected: ignores do not apply to files
# git already tracks, which is why it went unnoticed.)
test_*.py
!**/tests/test_*.py
!**/tests/**/test_*.py
!**/test/test_*.py
!**/test/**/test_*.py

# Environment files with secrets
.env
.env.*
**/.env
!**/.env.example

# Build artifacts
**/dist/
**/node_modules/
*.tsbuildinfo
*.log

# Coverage / pytest artifacts
.coverage
coverage.xml
.pytest_cache/

# Local Python dev environments and editable-install metadata
**/.venv/
**/*.egg-info/

# Editor and OS artifacts
.vscode/
.idea/
.cursor/
.claude/
*.swp
.DS_Store

# Private per-deployment values: model routing and provider credentials.
# deploy/litellm/README.md tells operators to keep these out of the repo;
# this makes that stick.
deploy/litellm/values.*.yaml
!deploy/litellm/values.autorouting.example.yaml

# Private CA anchors for an internal gateway, fetched at build time via the
# Dockerfile's EXTRA_CA_CERT_URLS. Kept on disk for local builds and out of the
# tree on purpose: an open-source image must not ship one organisation's trust
# root. Ignored rather than merely remembered, because `git add -A` does not
# remember.
claw/ca-anchors/
